NEXT_PUBLIC_SOCKET_URL=http://localhost:3334
NEXT_PUBLIC_SEARCH_API_URL=http://localhost:3336
NEXT_PUBLIC_GOOGLE_SEARCH_API_URL=http://localhost:4011
NEXT_PUBLIC_SECURE_API_URL=http://localhost:3000

NEXT_PUBLIC_VENDOR_WEB_URL=http://localhost:3002
NEXT_PUBLIC_WHITE_LABEL_WEB_URL=http://localhost:3004
