# Local: copy to .env.local
# Test server: copy to .env.test.local and run with APP_ENV=test / NEXT_PUBLIC_APP_ENV=test

NODE_ENV=development
APP_ENV=dev
VENDERO_ENV=dev
NEXT_PUBLIC_APP_ENV=dev

API_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:3333

REALTIME_URL=http://localhost:3334
